        <!-- STAGE 2: Dual-Branch Feature Extraction -->
        <mxCell id="stage2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;shadow=1;" vertex="1" parent="1">
